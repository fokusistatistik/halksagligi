// Kocaeli İl Sağlık Müdürlüğü - Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. PERSONEL TABLOSU
// ============================================
model Personel {
  id String @id @default(uuid())

  // ZORUNLU KİŞİSEL BİLGİLER
  tc_kimlik_no String @unique
  ad           String
  soyad        String
  email        String @unique
  password     String // bcrypt hash
  telefon      String

  // İLİŞKİLER
  rol_id          String
  rol             Rol        @relation(fields: [rol_id], references: [id])
  birim_id        String
  birim           Birim      @relation(fields: [birim_id], references: [id])
  yonetici_id     String?
  yonetici        Personel?  @relation("YoneticiAlt", fields: [yonetici_id], references: [id], onDelete: SetNull)
  alt_personeller Personel[] @relation("YoneticiAlt")

  // OPSİYONEL BİLGİLER
  profil_foto_url String?
  sicil_no        String?
  unvan           String?
  dogum_tarihi    DateTime?
  cinsiyet        String? // Enum: Cinsiyet
  adres           String?
  il              String?   @default("Kocaeli")
  ilce            String?

  // İŞ BİLGİLERİ
  ise_baslama_tarihi DateTime?
  sozlesme_turu      String? // Enum: SozlesmeTuru

  // ACİL DURUM
  acil_durum_kisi    String?
  acil_durum_telefon String?

  // SİSTEM BİLGİLERİ
  aktif            Boolean   @default(true)
  ilk_giris        Boolean   @default(true) // Şifre değişimi için
  notlar           String?
  son_giris_tarihi DateTime?
  son_giris_ip     String?

  // ZAMAN DAMGALARI
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  created_by_id String?
  updated_by_id String?

  @@index([email])
  @@index([tc_kimlik_no])
  @@index([rol_id])
  @@index([birim_id])
  @@map("personel")
}

// ============================================
// 2. ROLLER TABLOSU
// ============================================
model Rol {
  id String @id @default(uuid())

  // TEMEL BİLGİLER
  kod      String  @unique // Sistem kodu
  ad       String  // Görünen ad
  aciklama String?
  seviye   Int     // 1-10 arası
  renk     String  @default("#64748b") // Hex renk kodu
  icon     String? // Lucide icon adı

  // DURUM
  aktif Boolean @default(true)

  // İLİŞKİLER
  personeller Personel[]
  yetkiler    RolYetki[]

  // ZAMAN DAMGALARI
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([kod])
  @@index([seviye])
  @@map("roller")
}

// ============================================
// 3. YETKİLER TABLOSU
// ============================================
model Yetki {
  id String @id @default(uuid())

  // TEMEL BİLGİLER
  kod      String  @unique // Örn: gorev.olustur
  ad       String
  kategori String  // GOREV, PERSONEL, BIRIM, vb.
  aciklama String?

  // İLİŞKİLER
  roller RolYetki[]

  // ZAMAN DAMGALARI
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([kod])
  @@index([kategori])
  @@map("yetkiler")
}

// ============================================
// 4. ROL-YETKİ İLİŞKİ TABLOSU
// ============================================
model RolYetki {
  rol_id   String
  rol      Rol    @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  yetki_id String
  yetki    Yetki  @relation(fields: [yetki_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@id([rol_id, yetki_id])
  @@map("rol_yetki")
}

// ============================================
// 5. BİRİMLER TABLOSU
// ============================================
model Birim {
  id String @id @default(uuid())

  // TEMEL BİLGİLER
  ad            String
  kod           String       @unique // Örn: KORFEZ-ASM
  tip           String       // Enum: BirimTip
  dis_birim_tip String?      // Enum: DisBirimTip

  // HİYERARŞİ
  // Dış birimler için zorunlu - Müdürlük birimlerine bağlı olmalı
  ust_birim_id String?
  ust_birim    Birim?  @relation("BirimHiyerarsi", fields: [ust_birim_id], references: [id], onDelete: SetNull)
  alt_birimler Birim[] @relation("BirimHiyerarsi")

  // SORUMLU
  sorumlu_kisi_id String?

  // İLETİŞİM
  adres   String?
  telefon String?
  email   String?

  // DURUM
  aktif         Boolean   @default(true)
  acilis_tarihi DateTime?
  notlar        String?

  // İLİŞKİLER
  personeller    Personel[]
  veri_girisleri SHMVeriGiris[] @relation("BirimVeriGiris") // Dış birimlerin verilerini takip eder

  // ZAMAN DAMGALARI
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([kod])
  @@index([tip])
  @@index([dis_birim_tip])
  @@index([ust_birim_id])
  @@map("birimler")
}

// ============================================
// 6. AKTİVİTE LOGLARI (Audit Trail)
// ============================================
model AktiviteLog {
  id String @id @default(uuid())

  // KULLANICI BİLGİSİ
  personel_id    String?
  personel_email String?

  // İŞLEM BİLGİSİ
  islem    String  // personel.ekle, rol.guncelle, veri.onayla vb.
  tablo    String  // personel, rol, birim, veri_giris
  kayit_id String? // İşlem yapılan kaydın ID'si
  aciklama String?

  created_at DateTime @default(now())

  @@index([personel_id])
  @@index([islem])
  @@index([created_at])
  @@map("aktivite_log")
}

// ============================================
// 7. VERİ GİRİŞLERİ (DIŞ BİRİMLER İÇİN)
// ============================================

// Dış Birim Veri Girişleri (ASM, HSM, VSD, İlçe Sağlık)
model SHMVeriGiris {
  id String @id @default(uuid())

  // İLİŞKİLER
  birim_id    String // Dış birim ID'si
  birim       Birim  @relation("BirimVeriGiris", fields: [birim_id], references: [id], onDelete: Cascade)
  personel_id String

  // TARİH BİLGİSİ
  tarih DateTime

  // VERİ ALANLARI (JSON olarak esnek tutulacak - her birim tipine göre değişir)
  veri String? // Esnek veri yapısı: { "alan": "değer", ... } (SQLite JSON desteği yok, string olarak saklayacağız)

  // NOTLAR VE AÇIKLAMALAR
  aciklama String?
  notlar   String?

  // WEBHOOK SENKRONİZASYONU
  webhook_gonderildi      Boolean   @default(false)
  webhook_gonderim_tarihi DateTime?
  webhook_yanit           String?   // JSON string

  // ONAY DURUMU
  onay_durumu           String @default("BEKLEMEDE") // Enum: OnayDurumu
  onaylayan_personel_id String?
  onay_tarihi           DateTime?
  onay_notu             String?
  red_gerekce           String? // Red gerekçesi

  // ZAMAN DAMGALARI
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  created_by_id String?
  updated_by_id String?

  @@unique([birim_id, tarih, personel_id]) // Aynı gün aynı kişi aynı birimde tek kayıt
  @@index([birim_id])
  @@index([personel_id])
  @@index([tarih])
  @@index([onay_durumu])
  @@map("shm_veri_giris")
}

// ============================================
// 8. ŞİFRE SIFIRLAMA TOKEN
// ============================================
model PasswordResetToken {
  id           String   @id @default(uuid())
  personel_id  String
  tc_kimlik_no String
  email        String
  token        String   @unique @default(uuid())
  expires_at   DateTime
  kullanildi   Boolean  @default(false)
  ip_adresi    String?
  created_at   DateTime @default(now())

  @@index([token])
  @@index([personel_id])
  @@map("password_reset_tokens")
}
