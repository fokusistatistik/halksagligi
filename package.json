    "tailwind-merge": "^2.5.4",
    "class-variance-authority": "^0.7.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "tailwindcss": "^3.4.14",
    "postcss": "^8.4.47",
