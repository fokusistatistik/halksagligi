# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/halksagligi?schema=public"

# ============================================
# NEXT.JS
# ============================================
# Application URL (production domain)
NEXT_PUBLIC_APP_URL="https://gorev.kocaelism.saglik.gov.tr"

# Node environment (development, production, test)
NODE_ENV="development"

# ============================================
# AUTHENTICATION
# ============================================
# NextAuth.js secret key (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# NextAuth URL (same as NEXT_PUBLIC_APP_URL in production)
NEXTAUTH_URL="http://localhost:3000"

# JWT secret for token signing
JWT_SECRET="your-jwt-secret-key-change-this"

# ============================================
# n8n WEBHOOK INTEGRATION
# ============================================
# n8n base URL
N8N_WEBHOOK_URL="https://n8n.fokusistatistik.com"

# n8n API key for authentication (if needed)
N8N_API_KEY="your-n8n-api-key"

# Webhook endpoints (relative to N8N_WEBHOOK_URL)
# /webhook/login
# /webhook/sifre-degistir
# /webhook/sifre-sifirla
# /webhook/sifre-yenile
# /webhook/gorev (task operations)

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Email service provider (handled by n8n)
# These are for reference - actual email sending is done via n8n
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@kocaelism.saglik.gov.tr"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Kocaeli İSM <noreply@kocaelism.saglik.gov.tr>"

# ============================================
# ADMIN CONFIGURATION
# ============================================
# Default admin credentials (first user)
ADMIN_EMAIL="admin@kocaelism.saglik.gov.tr"
ADMIN_PASSWORD="Admin123!ChangeMe"
ADMIN_TC="12345678901"

# ============================================
# FILE UPLOAD
# ============================================
# Maximum file upload size (in bytes)
MAX_FILE_SIZE="10485760" # 10MB

# Allowed file extensions (comma-separated)
ALLOWED_FILE_TYPES="jpg,jpeg,png,pdf,doc,docx,xls,xlsx"

# File storage URL (CDN or static server)
FILE_STORAGE_URL="https://static.fokusistatistik.com"

# ============================================
# SECURITY
# ============================================
# Rate limiting (managed in code, these are for reference)
RATE_LIMIT_PASSWORD_RESET_WINDOW="300000" # 5 minutes in ms
RATE_LIMIT_PASSWORD_RESET_MAX="1"

RATE_LIMIT_LOGIN_WINDOW="900000" # 15 minutes in ms
RATE_LIMIT_LOGIN_MAX="5"

# Session timeout (in seconds)
SESSION_TIMEOUT="86400" # 24 hours

# Password reset token expiry (in seconds)
PASSWORD_RESET_EXPIRY="3600" # 1 hour

# ============================================
# LOGGING
# ============================================
# Log level (error, warn, info, debug)
LOG_LEVEL="info"

# Enable audit logging
ENABLE_AUDIT_LOG="true"

# ============================================
# FEATURES FLAGS
# ============================================
# Enable/disable features
FEATURE_2FA="false" # Two-factor authentication (planned)
FEATURE_FILE_UPLOAD="true"
FEATURE_NOTIFICATIONS="true"

# ============================================
# MONITORING
# ============================================
# Sentry DSN for error tracking (optional)
SENTRY_DSN=""

# Analytics (optional)
ANALYTICS_ID=""

# ============================================
# CORS
# ============================================
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,https://gorev.kocaelism.saglik.gov.tr"
