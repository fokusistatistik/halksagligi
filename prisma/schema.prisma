// Kocaeli İl Sağlık Müdürlüğü - Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. PERSONEL TABLOSU
// ============================================
model Personel {
  id String @id @default(uuid())

  // ZORUNLU KİŞİSEL BİLGİLER
  tc_kimlik_no String @unique @db.VarChar(11)
  ad           String @db.VarChar(50)
  soyad        String @db.VarChar(50)
  email        String @unique @db.VarChar(100)
  password     String @db.VarChar(255) // bcrypt hash
  telefon      String @db.VarChar(15)

  // İLİŞKİLER
  rol_id          String
  rol             Rol        @relation(fields: [rol_id], references: [id])
  birim_id        String
  birim           Birim      @relation(fields: [birim_id], references: [id])
  yonetici_id     String?
  yonetici        Personel?  @relation("YoneticiAlt", fields: [yonetici_id], references: [id], onDelete: SetNull)
  alt_personeller Personel[] @relation("YoneticiAlt")

  // OPSİYONEL BİLGİLER
  profil_foto_url String?   @db.VarChar(255)
  sicil_no        String?   @db.VarChar(50)
  unvan           String?   @db.VarChar(100)
  dogum_tarihi    DateTime? @db.Date
  cinsiyet        Cinsiyet?
  adres           String?   @db.Text
  il              String?   @default("Kocaeli") @db.VarChar(50)
  ilce            String?   @db.VarChar(50)

  // İŞ BİLGİLERİ
  ise_baslama_tarihi DateTime?     @db.Date
  sozlesme_turu      SozlesmeTuru?

  // ACİL DURUM
  acil_durum_kisi    String? @db.VarChar(100)
  acil_durum_telefon String? @db.VarChar(15)

  // SİSTEM BİLGİLERİ
  aktif            Boolean   @default(true)
  ilk_giris        Boolean   @default(true) // Şifre değişimi için
  notlar           String?   @db.Text
  son_giris_tarihi DateTime?
  son_giris_ip     String?   @db.VarChar(45)

  // ZAMAN DAMGALARI
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  created_by_id String?
  updated_by_id String?

  @@index([email])
  @@index([tc_kimlik_no])
  @@index([rol_id])
  @@index([birim_id])
  @@map("personel")
}

enum Cinsiyet {
  ERKEK
  KADIN
  BELIRTMEK_ISTEMIYORUM
}

enum SozlesmeTuru {
  KADROLU
  SOZLESMELI
  GECICI
  STAJYER
}

// ============================================
// 2. ROLLER TABLOSU
// ============================================
model Rol {
  id String @id @default(uuid())

  // TEMEL BİLGİLER
  kod      String  @unique @db.VarChar(50) // Sistem kodu
  ad       String  @db.VarChar(100) // Görünen ad
  aciklama String? @db.Text
  seviye   Int     @db.Integer // 1-10 arası
  renk     String  @default("#64748b") @db.VarChar(7) // Hex renk kodu
  icon     String? @db.VarChar(50) // Lucide icon adı

  // DURUM
  aktif Boolean @default(true)

  // İLİŞKİLER
  personeller Personel[]
  yetkiler    RolYetki[]

  // ZAMAN DAMGALARI
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([kod])
  @@index([seviye])
  @@map("roller")
}

// ============================================
// 3. YETKİLER TABLOSU
// ============================================
model Yetki {
  id String @id @default(uuid())

  // TEMEL BİLGİLER
  kod      String  @unique @db.VarChar(100) // Örn: gorev.olustur
  ad       String  @db.VarChar(100)
  kategori String  @db.VarChar(50) // GOREV, PERSONEL, BIRIM, vb.
  aciklama String? @db.Text

  // İLİŞKİLER
  roller RolYetki[]

  // ZAMAN DAMGALARI
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([kod])
  @@index([kategori])
  @@map("yetkiler")
}

// ============================================
// 4. ROL-YETKİ İLİŞKİ TABLOSU
// ============================================
model RolYetki {
  rol_id   String
  rol      Rol    @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  yetki_id String
  yetki    Yetki  @relation(fields: [yetki_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@id([rol_id, yetki_id])
  @@map("rol_yetki")
}

// ============================================
// 5. BİRİMLER TABLOSU
// ============================================
model Birim {
  id String @id @default(uuid())

  // TEMEL BİLGİLER
  ad            String       @db.VarChar(200)
  kod           String       @unique @db.VarChar(50) // Örn: KORFEZ-ASM
  tip           BirimTip
  dis_birim_tip DisBirimTip? // Sadece DIS_BIRIM için: ASM, HSM, VSD, ILCE_SAGLIK

  // HİYERARŞİ
  // Dış birimler için zorunlu - Müdürlük birimlerine bağlı olmalı
  ust_birim_id String?
  ust_birim    Birim?  @relation("BirimHiyerarsi", fields: [ust_birim_id], references: [id], onDelete: SetNull)
  alt_birimler Birim[] @relation("BirimHiyerarsi")

  // SORUMLU
  sorumlu_kisi_id String?

  // İLETİŞİM
  adres   String? @db.Text
  telefon String? @db.VarChar(15)
  email   String? @db.VarChar(100)

  // DURUM
  aktif         Boolean   @default(true)
  acilis_tarihi DateTime? @db.Date
  notlar        String?   @db.Text

  // İLİŞKİLER
  personeller    Personel[]
  veri_girisleri SHMVeriGiris[] @relation("BirimVeriGiris") // Dış birimlerin verilerini takip eder

  // ZAMAN DAMGALARI
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([kod])
  @@index([tip])
  @@index([dis_birim_tip])
  @@index([ust_birim_id])
  @@map("birimler")
}

enum BirimTip {
  MUDURLUK // Müdürlük Birimleri - Kendi modüllerini görür
  DIS_BIRIM // Dış Birimler - Müdürlük birimlerine bağlı
}

enum DisBirimTip {
  ASM // Aile Sağlığı Merkezi
  HSM // Halk Sağlığı Merkezi (eski SHM)
  VSD // Verem Savaş Dispanseri
  ILCE_SAGLIK // İlçe Sağlık Müdürlüğü
}

// ============================================
// 6. AKTİVİTE LOGLARI (Audit Trail)
// ============================================
model AktiviteLog {
  id String @id @default(uuid())

  // KULLANICI BİLGİSİ
  personel_id    String?
  personel_email String? @db.VarChar(100)

  // İŞLEM BİLGİSİ
  islem    String  @db.VarChar(100) // personel.ekle, rol.guncelle, veri.onayla vb.
  tablo    String  @db.VarChar(50) // personel, rol, birim, veri_giris
  kayit_id String? @db.VarChar(255) // İşlem yapılan kaydın ID'si
  aciklama String? @db.Text

  created_at DateTime @default(now())

  @@index([personel_id])
  @@index([islem])
  @@index([created_at])
  @@map("aktivite_log")
}

// ============================================
// 7. VERİ GİRİŞLERİ (DIŞ BİRİMLER İÇİN)
// ============================================

// Dış Birim Veri Girişleri (ASM, HSM, VSD, İlçe Sağlık)
model SHMVeriGiris {
  id String @id @default(uuid())

  // İLİŞKİLER
  birim_id    String // Dış birim ID'si
  birim       Birim  @relation("BirimVeriGiris", fields: [birim_id], references: [id], onDelete: Cascade)
  personel_id String

  // TARİH BİLGİSİ
  tarih DateTime @db.Date

  // VERİ ALANLARI (JSON olarak esnek tutulacak - her birim tipine göre değişir)
  veri Json? // Esnek veri yapısı: { "alan": "değer", ... }

  // NOTLAR VE AÇIKLAMALAR
  aciklama String? @db.Text
  notlar   String? @db.Text

  // WEBHOOK SENKRONİZASYONU
  webhook_gonderildi      Boolean   @default(false)
  webhook_gonderim_tarihi DateTime?
  webhook_yanit           Json?

  // ONAY DURUMU
  onay_durumu           OnayDurumu @default(BEKLEMEDE)
  onaylayan_personel_id String?
  onay_tarihi           DateTime?
  onay_notu             String?    @db.Text
  red_gerekce           String?    @db.Text // Red gerekçesi

  // ZAMAN DAMGALARI
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  created_by_id String?
  updated_by_id String?

  @@unique([birim_id, tarih, personel_id]) // Aynı gün aynı kişi aynı birimde tek kayıt
  @@index([birim_id])
  @@index([personel_id])
  @@index([tarih])
  @@index([onay_durumu])
  @@map("shm_veri_giris")
}

enum OnayDurumu {
  BEKLEMEDE
  ONAYLANDI
  REDDEDILDI
}

// ============================================
// 8. ŞİFRE SIFIRLAMA TOKEN
// ============================================
model PasswordResetToken {
  id           String   @id @default(uuid())
  personel_id  String
  tc_kimlik_no String   @db.VarChar(11)
  email        String   @db.VarChar(100)
  token        String   @unique @default(uuid())
  expires_at   DateTime
  kullanildi   Boolean  @default(false)
  ip_adresi    String?  @db.VarChar(45)
  created_at   DateTime @default(now())

  @@index([token])
  @@index([personel_id])
  @@map("password_reset_tokens")
}
